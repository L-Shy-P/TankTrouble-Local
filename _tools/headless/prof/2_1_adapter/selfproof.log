=== 自证判定（B 组每个新成员都必须是真数据）===
PASS  getTank -> 对手坦克对象                       {"x":15,"y":35,"rot":2.4914345695754387,"fwd":false,"fire":false,"locked":false}
PASS  getTanks -> 2 辆                         {"n":2,"ids":["tank_a","tank_b"]}
PASS  getTankState.x/y/rot 仍在                 keys=x,y,rot,forward,back,left,right,fireDown,locked,speed,rotationSpeed,ammo,shield
PASS  getTankState.ammo 有值                    {"weaponId":"bw-6fc0-7","type":-1,"numBullets":5,"bulletsFired":0,"numMines":null,"triggerPulled":false,"remainingByDifference":5}
PASS  getTankState.shield 有值(B组已造盾)           {"upgradeId":"probe_shield_1","type":2,"lifetime":5.8329999999999975,"weakened":false}
FAIL  getProjectiles.lifeLeft 有值              n=0
FAIL  lifeLeft == lifetime-timeAlive        
PASS  getCollectibles -> 道具                   {"n":1,"sample":{"id":"c-6fc0-10","type":4,"x":65,"y":15,"rot":3.937}}
PASS  getTraps -> 地雷                          {"n":1,"sample":{"id":"probe_mine_1","type":4,"x":75,"y":25,"activated":false,"tripped":false,"detonated":false,"detonationTime":0,"timeAlive":0.167}}
PASS  getZones -> 区域                          {"n":1,"sample":{"id":"probe_zone_1","type":0,"tiles":1,"lifetime":3.8330000000000006,"expansionTime":null,"expansionSide":null,"expansionSeqLen":null}}
PASS  getUpgradeByPlayerIdAndType -> 护盾       {"id":"probe_shield_1","type":2,"lifetime":5.8329999999999975,"weakened":false}
PASS  getWeaponStates -> 活武器                  {"playerId":"tank_a","active":{"id":"bw-6fc0-7","type":-1,"fields":{"_numBullets":5,"_triggerPulled":false,"_bulletsFired":0,"_timeAlive":2.1669999999999967}},"defaultType":-1,"queued":[]}
PASS  getTeam -> 恒 0（NO_TEAM）                 value=0
PASS  getScores -> 每人 2 条                     n=4
PASS  getScoreByPlayerIdAndType -> 有值         {"playerId":"tank_a","type":0,"value":0}
PASS  getCounters -> 计时器                      [{"id":"probe_counter_1","type":0,"currentTime":59.832999999999984,"startTime":60}]
PASS  getState -> 字符串                         in round
PASS  getMatchConfig.crateTypes 有值            {"symmetric":false,"storm":false,"crateTypes":[0,1,2,3,4,5,6],"maxActivePlayerCount":8,"mode":1,"premium":false,"ranked":false}
PASS  getRoundState(true) 有 trap/zone/counter 段  {"tankStates":2,"projectileStates":0,"collectibleStates":1,"trapStates":1,"weaponStates":2,"upgradeStates":1,"counterStates":1,"zoneStates":1,"isExpanded":true}
FAIL  locked 吞按键（fireDown getter=false 而 raw=true）  {"locked":true,"forward":false,"fireDown":false,"raw_forward":false,"raw_fireDown":false,"adapter_locked":true,"adapter_forward":false,"adapter_fireDown":false,"adapter_speed":0,"adapter_rotationSpeed":0}
PASS  x/y/rot 三字段未变语义（A 组就有）                  {"x":5,"y":15,"rot":4.843219650963062,"forward":false,"back":false,"left":false,"right":false,"fireDown":false,"locked":false,"speed":0,"rotationSpeed":0,"ammo"
SUMMARY {"pass":18,"fail":3,"fails":["getProjectiles.lifeLeft 有值","lifeLeft == lifetime-timeAlive","locked 吞按键（fireDown getter=false 而 raw=true）"]}
