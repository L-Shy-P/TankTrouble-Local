=== 自证判定（B 组每个新成员都必须是真数据）===
PASS  getTank -> 对手坦克对象                       {"x":35,"y":45,"rot":0.4878736426643469,"fwd":false,"fire":false,"locked":false}
PASS  getTanks -> 2 辆                         {"n":2,"ids":["tank_a","tank_b"]}
PASS  getTankState.x/y/rot 仍在                 keys=x,y,rot,forward,back,left,right,fireDown,locked,speed,rotationSpeed,ammo,shield
PASS  getTankState.ammo 有值                    {"weaponId":"bw-ad11-7","type":-1,"numBullets":5,"bulletsFired":2,"numMines":null,"triggerPulled":false,"remainingByDifference":3}
PASS  getTankState.shield 有值(B组已造盾)           {"upgradeId":"probe_shield_1","type":2,"lifetime":5.8329999999999975,"weakened":false}
PASS  getProjectiles.lifeLeft 有值              n=2
PASS  lifeLeft == lifetime-timeAlive          {"id":"b-ad11-9","lifeTotal":10,"timeAlive":0.167,"expect":9.833,"got":9.833,"match":true}
PASS  getCollectibles -> 道具                   {"n":1,"sample":{"id":"c-ad11-11","type":4,"x":5,"y":5,"rot":5.11}}
PASS  getTraps -> 地雷                          {"n":1,"sample":{"id":"probe_mine_1","type":4,"x":55,"y":35,"activated":false,"tripped":false,"detonated":false,"detonationTime":0,"timeAlive":0.167}}
PASS  getZones -> 区域                          {"n":1,"sample":{"id":"probe_zone_1","type":0,"tiles":1,"lifetime":3.8330000000000006,"expansionTime":null,"expansionSide":null,"expansionSeqLen":null}}
PASS  getUpgradeByPlayerIdAndType -> 护盾       {"id":"probe_shield_1","type":2,"lifetime":5.8329999999999975,"weakened":false}
PASS  getWeaponStates -> 活武器                  {"playerId":"tank_a","active":{"id":"bw-ad11-7","type":-1,"fields":{"_numBullets":5,"_triggerPulled":false,"_bulletsFired":2,"_timeAlive":2.1669999999999967}},"defaultType":-1,"queued":[]}
PASS  getTeam -> 恒 0（NO_TEAM）                 value=0
PASS  getScores -> 每人 2 条                     n=4
PASS  getScoreByPlayerIdAndType -> 有值         {"playerId":"tank_a","type":0,"value":0}
PASS  getCounters -> 计时器                      [{"id":"probe_counter_1","type":0,"currentTime":59.832999999999984,"startTime":60}]
PASS  getState -> 字符串                         in round
PASS  getMatchConfig.crateTypes 有值            {"symmetric":false,"storm":false,"crateTypes":[0,1,2,3,4,5,6],"maxActivePlayerCount":8,"mode":1,"premium":false,"ranked":false}
PASS  getRoundState(true) 有 trap/zone/counter 段  {"tankStates":2,"projectileStates":2,"collectibleStates":1,"trapStates":1,"weaponStates":2,"upgradeStates":1,"counterStates":1,"zoneStates":1,"isExpanded":true}
